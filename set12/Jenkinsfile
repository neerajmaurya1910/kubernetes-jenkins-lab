pipeline {
    agent any

    environment {
        PATH = "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    }

    stages {
        stage('Verify Docker') {
            steps {
                sh 'which docker'
                sh 'docker --version'
                sh 'docker info --format "Docker engine: {{.ServerVersion}}"'
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('set12') {
                    sh 'docker build -t kubernetes-jenkins-set12:1.0 .'
                }
            }
        }

        stage('Verify Image') {
            steps {
                sh 'docker image inspect kubernetes-jenkins-set12:1.0'
                sh 'echo "Docker image verification passed."'
            }
        }

        stage('Test Application') {
            steps {
                sh 'curl -fsS http://localhost:8085 | grep -q "Docker and Jenkins Integration Successful"'
                sh 'echo "Application HTTP test passed."'
            }
        }
    }

    post {
        success {
            echo 'SET 12 PASSED: Jenkins built and verified the Docker image and application.'
        }
        failure {
            echo 'SET 12 FAILED: Check the Console Output.'
        }
    }
}
